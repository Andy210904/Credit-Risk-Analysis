    <script>
        // --- Global State and Constants ---
        const RAG_THRESHOLDS = {
            RED_MAX: 50,    // High Risk: 0% to 50% Approval
            AMBER_MAX: 80,  // Moderate Risk: 51% to 80% Approval
            GREEN_MAX: 100  // Low Risk: 81% to 100% Approval
        };

        // Mock thresholds for factor analysis (for interpretability/reasoning)
        const MOCK_THRESHOLDS = {
            "ebitda_margin_pct": { low: 20, high: 10, compare: '>', unit: '%', risk: 'lower' }, // Good if > 20
            "debt_to_equity": { low: 0.5, high: 2.0, compare: '<', unit: 'x', risk: 'higher' }, // Good if < 0.5
            "current_ratio": { low: 2.0, high: 1.0, compare: '>', unit: 'x', risk: 'lower' },   // Good if > 2.0
            "country_risk_0_100": { low: 70, high: 30, compare: '>', unit: '/100', risk: 'lower' }, // Good if > 70 (lower risk score means lower risk)
            "collateral_coverage_pct": { low: 100, high: 80, compare: '>', unit: '%', risk: 'lower' }, // Good if > 100
            "payment_incidents_12m": { low: 0, high: 2, compare: '<', unit: ' count', risk: 'higher' } // Good if = 0
        };

        let currentRiskResult = null;
        let currentPage = 'Dashboard';
        let applicationHistory = []; // Dynamic array to store processed applications

        // Mock Firebase variables (required for environment setup)
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-credit-risk-app-id';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};


        // --- Mock Data (Single Sample Input) ---
        // This is the default data loaded into the form
        const SAMPLE_INPUT = {
            "ebitda_margin_pct": 15.2, "ebit_margin_pct": 10.5,
            "debt_to_equity": 0.8, "interest_coverage": 3.2,
            "dscr": 1.5, "current_ratio": 2.1,
            "quick_ratio": 1.8, "revenue_usd_m": 250,
            "years_in_operation": 15,
            "governance_score_0_100": 85, 
            "country_risk_0_100": 40, 
            "collateral_coverage_pct": 120, 
            "payment_incidents_12m": 0,
        };

        const FIELD_LABELS = {
            "ebitda_margin_pct": "EBITDA Margin (%)", "ebit_margin_pct": "EBIT Margin (%)",
            "debt_to_equity": "Debt to Equity Ratio", "interest_coverage": "Interest Coverage",
            "dscr": "DSCR (Debt Service Coverage Ratio)", "current_ratio": "Current Ratio",
            "quick_ratio": "Quick Ratio", "revenue_usd_m": "Revenue (USD M)",
            "years_in_operation": "Years in Operation",
            "governance_score_0_100": "Governance Score (0-100)", 
            "country_risk_0_100": "Country Risk (0-100)", 
            "collateral_coverage_pct": "Collateral Coverage (%)",
            "payment_incidents_12m": "Payment Incidents (12M)",
        };

        // Filter for essential inputs for the simpler form
        const essentialFields = [
            "debt_to_equity", "dscr", "current_ratio", 
            "ebitda_margin_pct", "revenue_usd_m", "years_in_operation",
            "governance_score_0_100", "country_risk_0_100", "collateral_coverage_pct", 
            "payment_incidents_12m"
        ];


        // --- Mock Risk Evaluation Function (Simulating AI/ML Engine) ---
        function evaluateRisk(inputData) {
            // This structure will hold factor evaluations and reasons
            const factors = [];
            let highRiskCount = 0;
            let lowRiskCount = 0;

            // Simple mock logic based on inputData
            for (const key of essentialFields) {
                const value = inputData[key];
                const rule = MOCK_THRESHOLDS[key];
                let evaluation = 'Medium';

                if (rule) {
                    let isGood = false;
                    let isBad = false;
                    
                    if (rule.compare === '>') { // e.g., EBITDA > 20
                        if (value > rule.low) isGood = true;
                        if (value < rule.high) isBad = true;
                    } else if (rule.compare === '<') { // e.g., Debt/Equity < 0.5
                        if (value < rule.low) isGood = true;
                        if (value > rule.high) isBad = true;
                    }

                    if (isGood) {
                        evaluation = 'Low'; // Very good
                        lowRiskCount++;
                    } else if (isBad) {
                        evaluation = 'High'; // High risk
                        highRiskCount++;
                    }
                }
                
                factors.push({ 
                    factor: key, 
                    evaluation: evaluation, 
                    value: value,
                });
            }

            // Determine final risk and prediction based on mock factors
            let FINAL_EVALUATION = 'Low';
            let approvalPredictionPct = 85;

            if (highRiskCount >= 2 || highRiskCount > lowRiskCount) {
                FINAL_EVALUATION = 'Red';
                approvalPredictionPct = Math.floor(Math.random() * (RAG_THRESHOLDS.RED_MAX - 10)) + 10;
            } else if (highRiskCount === 1 || factors.filter(f => f.evaluation === 'Medium').length > 5) {
                FINAL_EVALUATION = 'Amber';
                approvalPredictionPct = Math.floor(Math.random() * (RAG_THRESHOLDS.AMBER_MAX - RAG_THRESHOLDS.RED_MAX)) + RAG_THRESHOLDS.RED_MAX + 5;
            } else {
                 FINAL_EVALUATION = 'Low';
                 approvalPredictionPct = Math.floor(Math.random() * (RAG_THRESHOLDS.GREEN_MAX - RAG_THRESHOLDS.AMBER_MAX)) + RAG_THRESHOLDS.AMBER_MAX + 5;
            }

            const summary = FINAL_EVALUATION === 'Red'
                ? "The application presents **High Risk (Red)** primarily due to multiple non-compliant factors. This significantly increases the likelihood of default, and **rejection is strongly recommended**."
                : FINAL_EVALUATION === 'Amber'
                ? "The application presents **Moderate Risk (Amber)**. While profitability is solid, one or more key factors are borderline. **Conditional approval requiring additional collateral or detailed due diligence** is the recommended action."
                : "The application presents **Low Risk (Green)**. Key financial ratios are strong, collateral is excellent, and governance is high. This application qualifies for a **fast-track approval process**."


            return {
                factors: factors,
                summary: summary,
                final_evaluation: FINAL_EVALUATION,
                approval_prediction_pct: approvalPredictionPct,
                applicant_id: 'CUS-' + (Math.floor(Math.random() * 90000) + 10000),
                input_data: inputData // Pass original input for display
            };
        }


        // --- Page Render Functions ---

        function renderDashboard() {
            const totalApps = applicationHistory.length;
            const acceptedCount = applicationHistory.filter(h => h.status.includes('Accepted') || h.status.includes('Approved')).length;
            const rejectedCount = totalApps - acceptedCount;
            
            // Calculate mock distribution percentages based on current history
            const lowRiskCount = applicationHistory.filter(h => h.risk === 'Low').length;
            const amberRiskCount = applicationHistory.filter(h => h.risk === 'Amber').length;
            const redRiskCount = applicationHistory.filter(h => h.risk === 'Red').length;

            const lowPct = totalApps > 0 ? (lowRiskCount / totalApps * 100).toFixed(0) : 65;
            const amberPct = totalApps > 0 ? (amberRiskCount / totalApps * 100).toFixed(0) : 20;
            const redPct = totalApps > 0 ? (redRiskCount / totalApps * 100).toFixed(0) : 15;


            return '' +
                '<div class="space-y-8">' +
                    '<h2 class="text-3xl font-extrabold text-gray-800">Credit Risk Analyzer: Executive Dashboard</h2>' +
                    '<div class="grid grid-cols-1 md:grid-cols-3 gap-6">' +
                        '<!-- Card 1: Total Processed -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-indigo-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Total Applications Processed</h3>' +
                            '<p class="text-5xl font-extrabold text-gray-900">' + totalApps + '</p>' +
                            '<p class="text-sm text-indigo-600 mt-1">Dynamically updated on submission</p>' +
                        '</div>' +
                        '<!-- Card 2: Total Accepted -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-green-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Total Accepted</h3>' +
                            '<p class="text-5xl font-extrabold text-green-700">' + acceptedCount + '</p>' +
                            '<p class="text-sm text-green-600 mt-1">' + lowPct + '% of total portfolio</p>' +
                        '</div>' +
                        '<!-- Card 3: Total Rejected -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-red-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Total Rejected</h3>' +
                            '<p class="text-5xl font-extrabold text-red-700">' + rejectedCount + '</p>' +
                            '<p class="text-sm text-red-600 mt-1">' + redPct + '% of total portfolio</p>' +
                        '</div>' +
                    '</div>' +
                    
                    '<!-- Main Visualization Area -->' +
                    '<div class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100">' +
                        '<h2 class="text-2xl font-bold text-gray-800 mb-6">Portfolio Risk Distribution</h2>' +
                        '<div class="flex flex-wrap lg:flex-nowrap items-center space-y-6 lg:space-y-0 lg:space-x-10">' +
                            
                            '<!-- Distribution Stats -->' +
                            '<div class="w-full space-y-4">' +
                                '<div class="flex justify-between items-center p-4 bg-green-50 rounded-xl shadow-inner">' +
                                    '<span class="w-4 h-4 rounded-full bg-green-500 mr-4"></span>' +
                                    '<div class="flex-grow font-medium text-green-800">Low Risk (Green)</div>' +
                                    '<div class="text-2xl font-bold text-green-700">' + lowPct + '%</div>' +
                                '</div>' +
                                '<div class="flex justify-between items-center p-4 bg-yellow-50 rounded-xl shadow-inner">' +
                                    '<span class="w-4 h-4 rounded-full bg-yellow-500 mr-4"></span>' +
                                    '<div class="flex-grow font-medium text-yellow-800">Moderate Risk (Amber)</div>' +
                                    '<div class="text-2xl font-bold text-yellow-700">' + amberPct + '%</div>' +
                                '</div>' +
                                '<div class="flex justify-between items-center p-4 bg-red-50 rounded-xl shadow-inner">' +
                                    '<span class="w-4 h-4 rounded-full bg-red-500 mr-4"></span>' +
                                    '<div class="flex-grow font-medium text-red-800">High Risk (Red)</div>' +
                                    '<div class="text-2xl font-bold text-red-700">' + redPct + '%</div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
        }

