        // --- Mock ML Model Response (Simulates Backend ML Endpoint) ---
        function sendRequestToMLModel(inputData) {
            // This structure mimics a real fetch() POST request to a backend ML service
            return new Promise((resolve) => {
                
                // --- MOCK ML LOGIC START ---
                // Based on simple mock internal rules (you will replace this with your real ML model output logic)
                
                const debtRatio = inputData.debt_to_equity || 1.0;
                const coverage = inputData.interest_coverage || 2.0;
                const ebitda = inputData.ebitda_margin_pct || 15.0;
                
                let finalScore = 65; // Default Amber
                let finalEval = 'Amber';
                let summary = "The model suggests Moderate Risk. Performance metrics are solid but leverage remains a concern. Requires manual review.";

                if (debtRatio < 0.6 && coverage > 4.0) {
                    finalScore = Math.floor(Math.random() * (99 - 85)) + 85; // Low Risk
                    finalEval = 'Low';
                    summary = "The application presents **Low Risk (Green)**. Strong capital structure and excellent coverage metrics indicate a high likelihood of timely repayment. Fast-track approval recommended.";
                } else if (debtRatio > 1.5 || ebitda < 5.0) {
                    finalScore = Math.floor(Math.random() * (45 - 10)) + 10; // High Risk
                    finalEval = 'Red';
                    summary = "The application presents **High Risk (Red)**. Significant leverage and low profitability breach critical thresholds. Rejection is strongly recommended.";
                } else {
                     finalScore = Math.floor(Math.random() * (79 - 55)) + 55; // Amber Risk
                     finalEval = 'Amber';
                }
                
                // Map factors to match your original output requirements (using internal rules)
                const factors = Object.keys(inputData).map(key => ({
                    factor: key,
                    // Simple mock evaluation based on ML output
                    evaluation: (Math.random() > 0.8) ? 'Low' : (Math.random() > 0.6) ? 'High' : 'Medium',
                    value: inputData[key]
                }));
                // --- MOCK ML LOGIC END ---

                // Simulate network latency
                setTimeout(() => {
                    resolve({
                        factors: factors,
                        summary: summary,
                        final_evaluation: finalEval,
                        approval_prediction_pct: finalScore,
                        applicant_id: inputData.entity_id || ('CUS-' + (Math.floor(Math.random() * 90000) + 10000)),
                        input_data: inputData
                    });
                }, 1000); // 1 second mock response time
            });
        }


        // Helper function for CSV parsing
        function parseCSV(csvText) {
            const lines = csvText.trim().split('\n');
            if (lines.length < 2) return [];
            
            const headers = lines[0].split(',').map(h => h.trim());
            const data = [];
            
            for (let i = 1; i < lines.length; i++) {
                const values = lines[i].split(',').map(v => v.trim());
                if (values.length === headers.length) {
                    let client = {};
                    headers.forEach((header, index) => {
                        let value = values[index];
                        // Convert numeric fields based on expected keys
                        if (!isNaN(parseFloat(value))) {
                             client[header] = parseFloat(value);
                        } else {
                            client[header] = value;
                        }
                    });
                    data.push(client);
                }
            }
            return data;
        }

        // --- NEW: Individual Evaluation Handler ---
        async function handleIndividualEvaluation(clientData) {
            if (!userState.isLoggedIn) {
                showTemporaryMessage('Please log in to evaluate applications.', 'red');
                renderPage('Login');
                return;
            }
            // Use the client data and send it to the mock ML model
            showTemporaryMessage('Sending individual request to ML model...', 'blue');
            
            try {
                const result = await sendRequestToMLModel(clientData);
                currentRiskResult = result;
                
                // Determine final status
                const status = result.final_evaluation === 'Red' ? 'Rejected' : 
                               result.final_evaluation === 'Amber' ? 'Under Review' : 'Accepted';
                
                // Save result to history
                applicationHistory.push({
                    id: result.applicant_id,
                    date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
                    risk: result.final_evaluation,
                    score: result.approval_prediction_pct,
                    status: status,
                    color: result.final_evaluation === 'Low' ? 'green' : result.final_evaluation === 'Amber' ? 'yellow' : 'red'
                });

                showTemporaryMessage('ML Analysis Complete! See the Risk Evaluation page.', 'green');
                
                // Navigate to RiskEvaluation page for the result
                renderPage('RiskEvaluation');

            } catch (error) {
                console.error('ML Model Error:', error);
                showTemporaryMessage('ML Model failed to return a result.', 'red');
            }
        }

        // New function to handle file reading and storage
        function handleFileSelection(file) {
            if (!file) return;

            const fileType = file.name.split('.').pop().toLowerCase();
            const uploadBtn = document.getElementById('analyze-batch-btn');
            const fileNameDisplay = document.getElementById('file-name-display');

            if (fileType !== 'csv' && fileType !== 'json') {
                showTemporaryMessage('Unsupported file type. Please use CSV or JSON.', 'red');
                return;
            }
            
            // Disable analyze button until loading complete
            if (uploadBtn) uploadBtn.disabled = true;
            if (fileNameDisplay) fileNameDisplay.textContent = 'Reading file...';

            const reader = new FileReader();
            reader.onload = function(e) {
                let clientsData = [];
                try {
                    const contents = e.target.result;
                    if (fileType === 'json') {
                        clientsData = JSON.parse(contents);
                        if (!Array.isArray(clientsData)) clientsData = [clientsData]; // Handle single JSON object
                    } else if (fileType === 'csv') {
                        clientsData = parseCSV(contents);
                    }
                    
                    batchFileData = clientsData;
                    // Store the filename for display in the preview
                    batchFileData.file = file.name;

                    if (fileNameDisplay) fileNameDisplay.textContent = `${file.name} (${clientsData.length} clients loaded)`;
                    if (uploadBtn) {
                        uploadBtn.disabled = clientsData.length === 0;
                        uploadBtn.textContent = `Show Data Preview (${clientsData.length} Clients)`;
                    }
                    showTemporaryMessage(`File loaded: ${clientsData.length} applications ready for preview.`, 'blue');
                    
                    // Re-render the application upload page to show the new preview table
                    renderPage('ApplicationUpload');

                } catch (error) {
                    batchFileData = null;
                    if (fileNameDisplay) fileNameDisplay.textContent = 'Error during file parsing.';
                    if (uploadBtn) {
                        uploadBtn.disabled = true;
                        uploadBtn.textContent = 'Show Data Preview (0 Clients)';
                    }
                    showTemporaryMessage('Error parsing ' + fileType.toUpperCase() + ' file.', 'red');
                }
            };
            reader.readAsText(file);
        }

        // --- AUTHENTICATION FUNCTIONS ---
        function handleLogin(event) {
            event.preventDefault();
            const form = event.target;
            
            const userID = form.elements['userID'].value.trim();
            const password = form.elements['password'].value.trim();
            
            // Mocked authentication check
            if (userState.mockUsers[userID] && userState.mockUsers[userID].pass === password) {
                // Set session user details from the stored mock user data
                userState.isLoggedIn = true;
                userState.userName = userState.mockUsers[userID].name;
                userState.userEmail = userState.mockUsers[userID].email;
                userState.userInitials = userState.userName.substring(0, 1).toUpperCase();
                
                saveUserState();
                showTemporaryMessage(`Welcome back, ${userState.userName}!`, 'green');
                renderPage('Dashboard');
            } else {
                showTemporaryMessage('Invalid Analyst ID or Password. Check credentials.', 'red');
            }
        }
        
        function handleRegister(event) {
            event.preventDefault();
            const form = event.target;
            
            const userID = form.elements['newUserID'].value.trim();
            const password = form.elements['newPassword'].value.trim();
            const userName = form.elements['newUserName'].value.trim() || 'New Analyst';
            const userEmail = form.elements['newUserEmail'].value.trim() || 'newuser@risk.com';

            if (userState.mockUsers[userID]) {
                 showTemporaryMessage('User ID already exists. Please choose another.', 'red');
                 return;
            }

            // Mocked registration (saving to session state)
            userState.mockUsers[userID] = { pass: password, name: userName, email: userEmail };
            userState.isLoggedIn = true;
            userState.userName = userName;
            userState.userEmail = userEmail;
            userState.userInitials = userName.substring(0, 1).toUpperCase();
            
            saveUserState();
            showTemporaryMessage(`Account created! Welcome, ${userName}!`, 'green');
            renderPage('Dashboard');
        }


        function handleLogout() {
            userState.isLoggedIn = false;
            userState.userName = 'Guest';
            userState.userInitials = 'G';
            userState.userEmail = '';
            saveUserState();
            showTemporaryMessage('Logged out successfully.', 'blue');
            renderPage('Login');
        }


        // --- UI RENDERING FUNCTIONS ---

        function renderHeader() {
            const authArea = document.getElementById('auth-area');
            if (!authArea) return;

            if (userState.isLoggedIn) {
                const initials = userState.userInitials;
                const name = userState.userName;

                authArea.innerHTML = `
                    <div class="flex items-center space-x-4">
                        <span class="text-sm text-gray-500 hidden sm:inline">Hello, ${name}</span>
                        <div id="profile-dropdown-btn" class="h-10 w-10 bg-indigo-600 rounded-full flex items-center justify-center text-white font-bold cursor-pointer shadow-lg hover:ring-2 hover:ring-indigo-400">
                            ${initials}
                        </div>
                    </div>
                    <!-- Dropdown Menu -->
                    <div id="profile-dropdown-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-xl py-1 z-20 hidden">
                        <div class="px-4 py-2 text-sm text-gray-700 border-b">
                            <strong>${name}</strong><br>
                            <span class="text-xs text-gray-500">${userState.userEmail}</span>
                        </div>
                        <a href="#" id="logout-btn" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3v-4a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                            Logout
                        </a>
                    </div>
                `;
                // Attach listeners
                document.getElementById('profile-dropdown-btn').onclick = function() {
                    const menu = document.getElementById('profile-dropdown-menu');
                    menu.classList.toggle('hidden');
                };
                document.getElementById('logout-btn').onclick = handleLogout;
            } else {
                authArea.innerHTML = `
                    <button onclick="renderPage('Login')" class="bg-indigo-600 text-white text-sm font-semibold px-4 py-2 rounded-full shadow-md hover:bg-indigo-700 transition duration-150">
                        Login
                    </button>
                `;
            }
        }


        function renderDashboard() {
            if (!userState.isLoggedIn) return renderPage('Login'); // Auth check

            const totalApps = applicationHistory.length;
            
            // Calculate Accepted, Reviewed, Rejected
            const acceptedCount = applicationHistory.filter(h => h.status === 'Accepted').length;
            const reviewedCount = applicationHistory.filter(h => h.status === 'Under Review').length;
            const rejectedCount = applicationHistory.filter(h => h.status === 'Rejected').length;
            
            // Total Checks Out
            const totalChecksOut = (acceptedCount + rejectedCount + reviewedCount) === totalApps;

            // Calculate percentages
            const acceptedPct = totalApps > 0 ? (acceptedCount / totalApps * 100).toFixed(0) : 0;
            const rejectedPct = totalApps > 0 ? (rejectedCount / totalApps * 100).toFixed(0) : 0;
            const reviewedPct = totalApps > 0 ? (reviewedCount / totalApps * 100).toFixed(0) : 0;

            // Distribution percentages (RAG)
            const lowRiskCount = applicationHistory.filter(h => h.risk === 'Low').length;
            const amberRiskCount = applicationHistory.filter(h => h.risk === 'Amber').length;
            const redRiskCount = rejectedCount; // Red risk corresponds to rejected applications
            
            const lowPct = totalApps > 0 ? (lowRiskCount / totalApps * 100).toFixed(0) : 0;
            const amberPct = totalApps > 0 ? (amberRiskCount / totalApps * 100).toFixed(0) : 0;
            const redPct = totalApps > 0 ? (redRiskCount / totalApps * 100).toFixed(0) : 0; 

            // Initialize Chart data immediately
            setTimeout(() => {
                const ctx = document.getElementById('riskDistributionChart');
                if (ctx) {
                    new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: ['Low Risk (Accepted)', 'Moderate Risk (Under Review)', 'High Risk (Rejected)'],
                            // Use the calculated percentages (which are 0 when history is empty)
                            datasets: [{
                                data: [lowPct, amberPct, redPct],
                                backgroundColor: ['#10b981', '#f59e0b', '#ef4444'], // green, amber, red
                                hoverOffset: 10,
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        padding: 20,
                                        font: {
                                            size: 14,
                                        }
                                    }
                                },
                                title: {
                                    display: false,
                                }
                            }
                        }
                    });
                }
            }, 10); // Short delay to ensure Canvas element is rendered before initialization


            return '' +
                '<div class="space-y-8">' +
                    '<h2 class="text-3xl font-extrabold text-gray-800">Credit Risk Analyzer: Executive Dashboard</h2>' +
                    '<div class="grid grid-cols-1 md:grid-cols-4 gap-6">' +
                        '<!-- Card 1: Total Processed (Col 1) -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-indigo-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Total Applications Processed</h3>' +
                            '<p class="text-5xl font-extrabold text-gray-900">' + totalApps + '</p>' +
                            '<p class="text-sm text-indigo-600 mt-1">Status Check: ' + (totalChecksOut ? 'OK' : 'Error') + '</p>' +
                        '</div>' +
                        '<!-- Card 2: Total Accepted (Col 2) -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-green-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Total Accepted</h3>' +
                            '<p class="text-5xl font-extrabold text-green-700">' + acceptedCount + '</p>' +
                            '<p class="text-sm text-green-600 mt-1">' + acceptedPct + '% of total portfolio</p>' +
                        '</div>' +
                        '<!-- Card 3: Under Review (New Card, Col 3) -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-yellow-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Under Review (Manual)</h3>' +
                            '<p class="text-5xl font-extrabold text-yellow-700">' + reviewedCount + '</p>' +
                            '<p class="text-sm text-yellow-600 mt-1">' + reviewedPct + '% of total portfolio</p>' +
                        '</div>' +
                        '<!-- Card 4: Total Rejected (Col 4) -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-red-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Total Rejected</h3>' +
                            '<p class="text-5xl font-extrabold text-red-700">' + rejectedCount + '</p>' +
                            '<p class="text-sm text-red-600 mt-1">' + rejectedPct + '% of total portfolio</p>' +
                        '</div>' +
                    '</div>' +
                    
                    '<!-- Main Visualization Area -->' +
                    '<div class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100">' +
                        '<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">' +
                            '<!-- Chart Area (Doughnut Chart) -->' +
                            '<div class="h-64 flex justify-center">' +
                                '<canvas id="riskDistributionChart" class="w-full"></canvas>' +
                            '</div>' +
                            '<!-- Distribution Stats -->' +
                            '<div class="w-full space-y-4">' +
                                '<h2 class="text-2xl font-bold text-gray-800 mb-6">Portfolio Risk Distribution</h2>' +
                                '<div class="flex justify-between items-center p-4 bg-green-50 rounded-xl shadow-inner">' +
                                    '<span class="w-4 h-4 rounded-full bg-green-500 mr-4"></span>' +
                                    '<div class="flex-grow font-medium text-green-800">Low Risk (Green)</div>' +
                                    '<div class="text-2xl font-bold text-green-700">' + lowPct + '%</div>' +
                                '</div>' +
                                '<div class="flex justify-between items-center p-4 bg-yellow-50 rounded-xl shadow-inner">' +
                                    '<span class="w-4 h-4 rounded-full bg-yellow-500 mr-4"></span>' +
                                    '<div class="flex-grow font-medium text-yellow-800">Moderate Risk (Amber)</div>' +
                                    '<div class="text-2xl font-bold text-yellow-700">' + amberPct + '%</div>' +
