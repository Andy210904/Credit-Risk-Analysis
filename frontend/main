                                    '<div class="flex-grow font-medium text-red-800">High Risk (Red)</div>' +
                                    '<div class="text-2xl font-bold text-red-700">' + redPct + '%</div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
        }

        function renderApplicationUpload() {
            if (!userState.isLoggedIn) return renderPage('Login'); // Auth check
             // Helper function to create form input HTML
            const createInput = (label, id, value, type = 'number', step = '0.1') => {
                const displayValue = SAMPLE_INPUT[id] !== undefined ? SAMPLE_INPUT[id] : value;
                return '<div class="flex flex-col">' +
                    '<label for="' + id + '" class="text-sm font-medium text-gray-700 mb-1">' + label + '</label>' +
                    '<input type="' + type + '" id="' + id + '" value="' + displayValue + '" step="' + step + '"' +
                        'class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 shadow-sm disabled:bg-gray-50"' +
                        'placeholder="' + label + '" required>' +
                '</div>';
            }
            
            const formInputs = essentialFields.map(key => {
                const label = FIELD_LABELS[key];
                const value = SAMPLE_INPUT[key];
                const step = ['years_in_operation', 'governance_score_0_100', 'country_risk_0_100', 'payment_incidents_12m'].includes(key) ? '1' : '0.1';
                return createInput(label, key, value, 'number', step);
            }).join('');

            // Determine initial state of analyze button
            const batchCount = batchFileData ? batchFileData.length : 0;
            const initialAnalyzeBtnText = batchFileData ? `Show Data Preview (${batchFileData.length} Clients)` : 'Show Data Preview (0 Clients)';
            const isAnalyzeDisabled = !batchFileData || batchFileData.length === 0;

            // --- BATCH DATA PREVIEW GENERATION ---
            let batchPreviewHtml = '';
            if (batchFileData && batchFileData.length > 0) {
                // Get all essential field labels for the table header
                const tableHeaders = previewFields.map(key => 
                    '<th class="p-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w-[100px]">' + (FIELD_LABELS[key] || key) + '</th>'
                ).join('');

                // Generate table rows for ALL clients in the batch (not just first 5 for the new use case)
                const tableRows = batchFileData.map((client, index) => {
                    // Collect all essential data points
                    const clientDataCells = previewFields.map(key => 
                        '<td class="p-3 whitespace-nowrap text-sm text-gray-600">' + (client[key] !== undefined ? client[key] : 'N/A') + '</td>'
                    ).join('');
                    
                    // Create a sanitized JSON string of the client data for the inline evaluation call
                    const clientDataJson = JSON.stringify(client).replace(/"/g, '&quot;');


                    return '<tr class="border-b border-gray-100 hover:bg-gray-50">' + 
                           clientDataCells + 
                           // New Action Column with Evaluate Button
                           '<td class="p-3 whitespace-nowrap">' +
                               '<button onclick="handleIndividualEvaluation(' + clientDataJson + ')" class="bg-indigo-500 hover:bg-indigo-600 text-white text-xs font-semibold py-1 px-3 rounded-full shadow-md transition duration-150">' +
                                   'Evaluate' +
                               '</button>' +
                           '</td>' +
                           '</tr>';
                }).join('');

                batchPreviewHtml = '' +
                    '<div id="batch-data-preview-table" class="lg:col-span-3 bg-white p-8 rounded-2xl shadow-xl border-t-4 border-indigo-200 mt-8">' +
                        '<h2 class="text-xl font-bold text-gray-800 mb-4">Batch Data Preview (' + batchFileData.file + ')</h2>' +
                        '<p class="text-sm text-gray-500 mb-4">Click "Evaluate" for an individual client to run the risk engine.</p>' +
                        '<div class="overflow-x-auto max-h-[500px] relative border border-gray-200 rounded-lg">' +
                            '<table class="min-w-full divide-y divide-gray-200">' +
                                '<thead class="bg-gray-50 sticky top-0">' +
                                    '<tr>' +
                                        tableHeaders +
                                        '<th class="p-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w-[80px]">Action</th>' +
                                    '</tr>' +
                                '</thead>' +
                                '<tbody class="divide-y divide-gray-100">' +
                                    tableRows +
                                '</tbody>' +
                            '</table>' +
                        '</div>' +
                    '</div>';
            }
            // --- END BATCH DATA PREVIEW GENERATION ---


            return '' +
                '<div class="space-y-8">' +
                    '<h2 class="text-3xl font-extrabold text-gray-800">New Application Submission (Data Input)</h2>' +
                    '<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">' +
                        '<!-- Upload/CSV Card (Col 1) -->' +
                        '<div class="lg:col-span-1 bg-white p-8 rounded-2xl shadow-xl flex flex-col justify-between">' +
                            '<h2 class="text-xl font-bold text-gray-800 mb-4">Batch Upload (.csv or .json)</h2>' +
                            '<div id="drop-area" class="border-2 border-dashed border-indigo-300 bg-indigo-50 rounded-xl p-8 text-center transition duration-200 hover:border-indigo-500 cursor-pointer">' +
                                '<svg class="w-10 h-10 mx-auto text-indigo-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5.002 5.002 0 0113.974 4C14.048 4.046 14.12 4 14.2 4a5 5 0 014.59 7.424m-8.563 4.34a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L10 14.586l7.293-7.293a1 1 0 011.414 1.414l-8 8a1 1 0 01-1.414 0z"></path></svg>' +
                                '<p id="file-name-display" class="text-gray-600 font-medium">' + (batchFileData ? batchFileData.file : 'Drag & drop files here') + '</p>' +
                                '<input type="file" id="file-input" class="hidden" accept=".csv, .json">' +
                            '</div>' +
                            // Button now triggers preview re-render
                            '<button id="analyze-batch-btn" ' + (isAnalyzeDisabled ? 'disabled' : '') + ' class="mt-6 w-full bg-indigo-600 text-white px-4 py-3 rounded-xl font-semibold hover:bg-indigo-700 transition duration-150 shadow-lg disabled:bg-indigo-300">' +
                                initialAnalyzeBtnText +
                            '</button>' +
                            '<button id="file-select-btn" class="mt-3 w-full bg-gray-200 text-gray-800 px-4 py-3 rounded-xl font-semibold hover:bg-gray-300 transition duration-150 shadow-md">' +
                                'Or Select File' +
                            '</button>' +
                        '</div>' +
                        
                        // Inject the data preview table here (Col 2 & 3 - spans 2 columns)
                        (batchFileData ? batchPreviewHtml.replace('lg:col-span-3', 'lg:col-span-2') : '') +

                    '</div>' +
                    
                    // Manual Form Card now takes up the entire row (lg:col-span-3)
                    '<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">' +
                        '<div class="lg:col-span-3 bg-white p-8 rounded-2xl shadow-xl">' +
                            '<h2 class="text-xl font-bold text-gray-800 mb-6">Manual Credit Application Input (10 Key Factors)</h2>' +
                            '<form id="risk-evaluation-form" onsubmit="handleFormSubmission(event)" class="space-y-6">' +
                                '<div class="grid grid-cols-1 md:grid-cols-2 gap-6">' +
                                    formInputs +
                                '</div>' +
                                '<div class="pt-6 flex justify-end">' +
                                    '<button type="submit" class="bg-indigo-600 text-white px-8 py-3 rounded-xl font-semibold hover:bg-indigo-700 transition duration-150 shadow-lg transform hover:scale-[1.01] flex items-center">' +
                                        '<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>' +
                                        'Run Risk Evaluation' +
                                    '</button>' +
                                '</div>' +
                            '</form>' +
                        '</div>' +
                    '</div>' +
                '</div>';
        }

