        /**
         * Renders the Risk Evaluation page with the RAG Gauge and factor table.
         * @param {object} result - The risk assessment result from the evaluation function.
         */
        function renderRiskEvaluation(result) {
            if (!userState.isLoggedIn) return renderPage('Login'); // Auth check
            const riskLevel = result.final_evaluation; // Red, Amber, or Medium (Amber)
            const approvalPct = result.approval_prediction_pct;
            
            let colorClass = 'text-red-600 bg-red-100';
            let rotationDeg = 0; // 0 to 180 degrees mapping to 0% to 100%

            // Calculate rotation for the needle (0% -> 0deg, 100% -> 180deg)
            rotationDeg = (approvalPct / 100) * 180;
            // Ensure rotation stays within 0 to 180 degrees
            rotationDeg = Math.min(180, Math.max(0, rotationDeg));


            if (approvalPct > RAG_THRESHOLDS.AMBER_MAX) { 
                colorClass = 'text-green-600 bg-green-100';
            } else if (approvalPct > RAG_THRESHOLDS.RED_MAX) { 
                colorClass = 'text-yellow-600 bg-yellow-100';
            } else { 
                colorClass = 'text-red-600 bg-red-100';
            }
            
            // Generate the table rows for factors
            const factorRows = result.factors.map(f => {
                let cellColor = '';
                if (f.evaluation === 'Low') cellColor = 'bg-green-100 text-green-700';
                if (f.evaluation === 'Medium') cellColor = 'bg-yellow-100 text-yellow-700';
                if (f.evaluation === 'High') cellColor = 'bg-red-100 text-red-700';
                
                const label = FIELD_LABELS[f.factor] || f.factor;
                
                let comparisonText = 'Rule Not Defined';
                const rule = MOCK_THRESHOLDS[f.factor];
                if (rule) {
                    const thresholdType = rule.compare === '>' ? 'Above' : 'Below';
                    const riskOutcome = rule.compare === '>' ? 'Higher' : 'Lower';
                    comparisonText = thresholdType + ' ' + rule.low + rule.unit + ' for ' + riskOutcome + ' Risk';
                }

                return '' +
                    '<tr class="hover:bg-gray-50 transition duration-100">' +
                        '<td class="p-4 whitespace-nowrap text-sm font-medium text-gray-800">' + label + '</td>' +
                        '<td class="p-4 whitespace-nowrap text-sm text-gray-600">' + f.value + '</td>' +
                        '<td class="p-4 whitespace-nowrap text-sm text-gray-600">' + comparisonText + '</td>' +
                        '<td class="p-4 whitespace-nowrap">' +
                            '<span class="inline-flex items-center px-4 py-1 text-xs font-semibold rounded-full ' + cellColor + ' capitalize shadow-sm">' +
                                f.evaluation + ' Risk' +
                            '</span>' +
                        '</td>' +
                    '</tr>';
            }).join('');

            return '' +
                '<div class="space-y-8">' +
                    '<h2 class="text-3xl font-bold text-gray-800">Risk Assessment for Applicant ID: <span class="text-indigo-600">' + result.applicant_id + '</span></h2>' +
                    
                    '<!-- RAG Gauge and Summary Section -->' +
                    '<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">' +
                        
                        '<!-- RAG Gauge Card (Col 1) -->' +
                        '<div class="lg:col-span-1 bg-white p-8 rounded-2xl shadow-xl text-center flex flex-col items-center justify-center">' +
                            '<h3 class="text-xl font-bold text-gray-700 mb-4">Credit Risk Status</h3>' +
                            
                            '<!-- Gauge Visualization -->' +
                            '<div class="relative w-64 h-32 mx-auto mb-6">' +
                                '<svg viewBox="0 0 100 50" class="w-full h-full overflow-hidden">' +
                                    '<!-- Background arc (The RAG segments) -->' +
                                    '<path d="M 5 50 A 45 45 0 0 1 95 50" fill="none" stroke="#e5e7eb" stroke-width="10" />' +
                                    '<!-- Green (Low Risk) 81%-100% -->' +
                                    '<path d="M 5 50 A 45 45 0 0 1 95 50" fill="none" stroke="#10b981" stroke-width="10" stroke-dasharray="16.96 283" stroke-dashoffset="-141.5" />' +
                                    '<!-- Amber (Moderate Risk) 51%-80% -->' +
                                    '<path d="M 5 50 A 45 45 0 0 1 95 50" fill="none" stroke="#f59e0b" stroke-width="10" stroke-dasharray="47.12 283" stroke-dashoffset="-113.25" />' +
                                    '<!-- Red (High Risk) 0%-50% -->' +
                                    '<path d="M 5 50 A 45 45 0 0 1 95 50" fill="none" stroke="#ef4444" stroke-width="10" stroke-dasharray="78.5 283" stroke-dashoffset="-66.13" />' +

                                    // FIX: Use a Polygon for a prominent arrow/needle shape
                                    '<polygon class="gauge-needle" points="50,50 48,15 52,15" ' +
                                        'style="transform: rotate(' + rotationDeg + 'deg); transition: transform 1.5s ease-in-out; fill: #1f2937;" />' +
                                    // Central Pivot Point (Circle)
                                    '<circle cx="50" cy="50" r="4" fill="#1f2937" />' +
                                '</svg>' +
                            '</div>' +

                            '<p class="text-5xl font-extrabold ' + colorClass.split(' ')[0] + ' mt-2">' + approvalPct + '<span class="text-2xl">%</span></p>' +
                            '<span class="inline-block px-4 py-1 mt-3 text-sm font-bold rounded-full ' + colorClass + ' uppercase tracking-wider shadow-md">' +
                                riskLevel + ' Risk' +
                            '</span>' +
                            '<p class="text-xs text-gray-400 mt-2">Predicted Approval Probability</p>' +
                        '</div>' +

                        '<!-- Summary and Interpretation (Col 2 & 3) -->' +
                        '<div class="lg:col-span-2 space-y-6">' +
                            '<div class="bg-white p-8 rounded-2xl shadow-xl border-l-4 border-indigo-400 h-full flex flex-col justify-center">' +
                                '<h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">' +
                                    '<svg class="w-6 h-6 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.62A9 9 0 115.38 5.38a9 9 0 0112.72 0z"></path></svg>' +
                                    'AI-Generated Assessment & Recommendation' +
                                '</h3>' +
                                '<p class="text-gray-700 leading-relaxed text-lg mb-4">' +
                                    result.summary +
                                '</p>' +
                                '<div class="mt-4 text-sm font-medium text-gray-600">' +
                                    // FIX 2: Updated decision text for Amber risk
                                    '<span class="text-indigo-600">Decision:</span> ' + (riskLevel === 'Red' ? 'Reject & Escalate.' : riskLevel === 'Amber' ? 'Requires Manual Review (Under Review).' : 'Fast-Track Approval.') +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +

                    '<!-- Detailed Factor Table (Reasoning) -->' +
                    '<div class="bg-white p-8 rounded-2xl shadow-xl overflow-x-auto">' +
                        '<h2 class="text-2xl font-bold text-gray-800 mb-6">Interpretability: Rule-Based Match Analysis</h2>' +
                        '<table class="min-w-full divide-y divide-gray-200">' +
                            '<thead>' +
                                '<tr class="bg-gray-50">' +
                                    '<th class="p-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Financial Factor</th>' +
                                    '<th class="p-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Input Value</th>' +
                                    '<th class="p-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Acceptance Threshold</th>' +
                                    '<th class="p-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Result</th>' +
                                '</tr>' +
                            '</thead>' +
                            '<tbody class="divide-y divide-gray-100">' +
                                factorRows +
                            '</tbody>' +
                        '</table>' +
                    '</div>' +
                '</div>';
        }
        
        function renderReports() {
            if (!userState.isLoggedIn) return renderPage('Login'); // Auth check
            const history = applicationHistory.slice().reverse(); // Use dynamic history and reverse for newest first
            
            // FIX 1: Recalculate based on fixed statuses
            const acceptedCount = history.filter(h => h.status === 'Accepted').length;
            const rejectedCount = history.filter(h => h.status === 'Rejected').length;
            const reviewedCount = history.filter(h => h.status === 'Under Review').length;

            if (history.length === 0) {
                 return '' +
                    '<div class="bg-white p-16 rounded-2xl shadow-xl border border-gray-100 text-center">' +
                        '<h2 class="text-2xl font-bold text-gray-800 mb-2">No Applications Processed</h2>' +
                        '<p class="text-gray-600 mb-8">The reports dashboard will populate automatically once you submit and evaluate your first application.</p>' +
                        '<!-- Added ID for event listener attachment -->' +
                        '<button id="start-new-evaluation-btn-report" class="bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-indigo-700 transition duration-150 shadow-lg">' +
                            'Process Application' +
                        '</button>' +
                    '</div>';
            }


            const historyRows = history.map(app => {
                let colorClass = app.color === 'green' ? 'bg-green-100 text-green-700' :
                                 app.color === 'yellow' ? 'bg-yellow-100 text-yellow-700' :
                                 'bg-red-100 text-red-700';
                return '' +
                    '<tr>' +
                        '<td class="p-4 whitespace-nowrap text-sm font-medium text-indigo-600">' + app.id + '</td>' +
                        '<td class="p-4 whitespace-nowrap text-sm text-gray-500">' + app.date + '</td>' +
                        '<td class="p-4 whitespace-nowrap text-sm text-gray-500">' + app.score + '%</td>' +
                        '<td class="p-4 whitespace-nowrap">' +
                            '<span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ' + colorClass + ' capitalize">' +
                                app.risk + ' Risk' +
                            '</span>' +
                        '</td>' +
                        '<td class="p-4 whitespace-nowrap text-sm font-semibold text-gray-700">' + app.status + '</td>' +
                    '</tr>';
            }).join('');

            return '' +
                '<div class="space-y-8">' +
                    '<h2 class="text-3xl font-extrabold text-gray-800">Historical Application Summary</h2>' +
                    '<div class="grid grid-cols-1 md:grid-cols-3 gap-6">' +
                         '<!-- Accepted Count -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-green-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Total Accepted</h3>' +
                            '<p class="text-5xl font-extrabold text-green-700">' + acceptedCount + '</p>' +
                            '<p class="text-sm text-gray-600 mt-1">Low Risk / Fast-Track</p>' +
                        '</div>' +
                        '<!-- Reviewed Count -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-yellow-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Total Under Review</h3>' +
                            '<p class="text-5xl font-extrabold text-yellow-700">' + reviewedCount + '</p>' +
                            '<p class="text-sm text-gray-600 mt-1">Moderate Risk / Manual Review</p>' +
                        '</div>' +
                        '<!-- Rejected Count -->' +
                        '<div class="bg-white p-6 rounded-2xl shadow-xl border-t-4 border-red-500">' +
                            '<h3 class="text-base font-semibold text-gray-500 mb-2">Total Rejected</h3>' +
                            '<p class="text-5xl font-extrabold text-red-700">' + rejectedCount + '</p>' +
                            '<p class="text-sm text-gray-600 mt-1">High Risk / Escalation</p>' +
                        '</div>' +
                    '</div>' +

                    '<div class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100 overflow-x-auto">' +
                        '<h2 class="text-2xl font-bold text-gray-800 mb-6">Recent Applications Log (Newest First)</h2>' +
                        '<table class="min-w-full divide-y divide-gray-200">' +
                            '<thead>' +
                                '<tr class="bg-gray-50">' +
                                    '<th class="p-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Applicant ID</th>' +
                                    '<th class="p-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>' +
                                    '<th class="p-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Approval Score</th>' +
                                    '<th class="p-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Risk Profile</th>' +
                                    '<th class="p-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Final Status</th>' +
                                '</tr>' +
                            '</thead>' +
                            '<tbody class="divide-y divide-gray-100">' +
                                historyRows +
                            '</tbody>' +
                        '</table>' +
                        '<div class="flex justify-end mt-6 space-x-3">' +
                            '<button class="bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium hover:bg-gray-300 transition duration-150 shadow-sm">Export PDF (Mock)</button>' +
                            '<button class="bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-indigo-700 transition duration-150 shadow-md">Export CSV</button>' +
                        '</div>' +
                    '</div>' +
                '</div>';
        }

        function renderLogin() {
             return '' +
                '<div class="flex items-center justify-center h-full">' +
                    '<div class="bg-white p-10 rounded-2xl shadow-2xl w-full max-w-md">' +
                        '<h2 class="text-3xl font-extrabold text-indigo-700 mb-2 text-center">Analyst Login</h2>' +
                        '<p class="text-gray-500 mb-8 text-center">Sign in to access the Credit Risk Gauge.</p>' +
                        
                        '<form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">' +
                            '<!-- Analyst ID -->' +
                            '<div class="flex flex-col">' +
                                '<label for="userID" class="text-sm font-medium text-gray-700 mb-1">Analyst ID </label>' +
                                '<input type="text" id="userID" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 shadow-sm" required>' +
                            '</div>' +
                            
                            '<!-- Password -->' +
                            '<div class="flex flex-col">' +
                                '<label for="password" class="text-sm font-medium text-gray-700 mb-1">Password </label>' +
                                '<input type="password" id="password" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 shadow-sm" required>' +
                            '</div>' +
                            
                            '<!-- HIDDEN FIELDS (Name and Email are retrieved from registered user data) -->' +
                            '<input type="hidden" id="userName" value="Analyst">' + 
                            '<input type="hidden" id="userEmail" value="analyst@risk.com">' +
                            
                            '<button type="submit" class="w-full bg-indigo-600 text-white font-semibold py-3 rounded-lg hover:bg-indigo-700 transition duration-150 shadow-lg mt-6">' +
                                'Login' +
                            '</button>' +
                        '</form>' +
                        
                        '<div class="text-center mt-4">' +
                            '<a href="#" onclick="renderPage(\'Register\'); return false;" class="text-sm text-indigo-600 hover:text-indigo-800">Need an account? Register Here</a>' +
                        '</div>' +
                    '</div>' +
                '</div>';
        }
        
        function renderRegister() {
             return '' +
                '<div class="flex items-center justify-center h-full">' +
                    '<div class="bg-white p-10 rounded-2xl shadow-2xl w-full max-w-md">' +
                        '<h2 class="text-3xl font-extrabold text-indigo-700 mb-2 text-center">Analyst Registration</h2>' +
