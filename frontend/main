        // Helper function to attach event listeners dynamically
        function setupDynamicListeners(pageName) {
            // Hide sidebar on Login/Register page
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.querySelector('.main-content');
            const authPages = ['Login', 'Register'];
            
            if (authPages.includes(pageName)) {
                sidebar.classList.add('hidden');
                mainContent.classList.add('w-full');
            } else {
                sidebar.classList.remove('hidden');
                mainContent.classList.remove('w-full');
            }
            
            // Re-attach listeners for common buttons
            if (pageName === 'RiskEvaluation' && !currentRiskResult) {
                const startBtn = document.getElementById('start-new-evaluation-btn');
                if (startBtn) {
                    startBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        renderPage('ApplicationUpload');
                    });
                }
            }
            if (pageName === 'Reports') {
                const startBtnReport = document.getElementById('start-new-evaluation-btn-report');
                if (startBtnReport) {
                     startBtnReport.addEventListener('click', (e) => {
                        e.preventDefault();
                        renderPage('ApplicationUpload');
                    });
                }
            }
            
            // Attach form handlers to the newly rendered forms
            if (pageName === 'Login') {
                document.getElementById('login-form').onsubmit = handleLogin;
            }
             if (pageName === 'Register') {
                document.getElementById('register-form').onsubmit = handleRegister;
            }

            // --- BATCH PROCESSING LISTENERS ---
            if (pageName === 'ApplicationUpload') {
                const fileSelectBtn = document.getElementById('file-select-btn');
                const fileInput = document.getElementById('file-input');
                const analyzeBatchBtn = document.getElementById('analyze-batch-btn');
                const dropArea = document.getElementById('drop-area');
                
                if (fileSelectBtn && fileInput) {
                    // Clicking "Or Select File" triggers file dialog
                    fileSelectBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        fileInput.click();
                    });

                    // File is selected, load it into memory (batchFileData)
                    fileInput.onchange = (e) => {
                        if (e.target.files.length > 0) {
                            handleFileSelection(e.target.files[0]);
                        }
                    };
                }
                
                // Drop area listeners
                ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                    dropArea.addEventListener(eventName, preventDefaults, false);
                });
                dropArea.addEventListener('drop', handleDrop, false);
                function preventDefaults(e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                function handleDrop(e) {
                    let dt = e.dataTransfer;
                    let files = dt.files;
                    if (files.length > 0) {
                        handleFileSelection(files[0]);
                    }
                }
                
                // Clicking "Analyze Batch" button triggers processing
                if (analyzeBatchBtn) {
                    analyzeBatchBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        if (batchFileData) {
                            // Pass the button element to update its state during processing
                            // NOTE: analyzeBatchBtn now triggers the PREVIEW, not the evaluation
                            renderPage('ApplicationUpload');
                        } else {
                            showTemporaryMessage('Please select a file first.', 'red');
                        }
                    });
                }
                
                // Form submission listener remains the same
                const form = document.getElementById('risk-evaluation-form');
                if (form) {
                    form.onsubmit = handleFormSubmission;
                }
            }
        }

        // --- Utility Functions (simplified) ---
        function renderPage(pageName) {
            
            // Block access to core pages if not logged in
            const restrictedPages = ['Dashboard', 'ApplicationUpload', 'RiskEvaluation', 'Reports', 'Settings'];
            if (restrictedPages.includes(pageName) && !userState.isLoggedIn) {
                // If attempting to access a restricted page, always redirect to Login
                if (pageName !== 'Register' && pageName !== 'Login') {
                    pageName = 'Login';
                }
            }

            currentPage = pageName;
            const contentDiv = document.getElementById('app-content');
            const titleDiv = document.getElementById('page-title');
            const menuItems = document.querySelectorAll('.menu-item');

            // Render Header (including auth status) before rendering content
            renderHeader();

            // Update active menu item
            menuItems.forEach(item => {
                item.classList.remove('active');
            });
            const activeItem = Array.from(menuItems).find(item => item.getAttribute('data-page') === pageName);
            // Only highlight menu item if it's not Login or Register
            if (activeItem && !['Login', 'Register'].includes(pageName)) {
                activeItem.classList.add('active');
            }

            titleDiv.textContent = pageName.replace(/([A-Z])/g, ' $1').trim();

            let pageContent;
            switch (pageName) {
                case 'Dashboard':
                    pageContent = renderDashboard();
                    break;
                case 'ApplicationUpload':
                    pageContent = renderApplicationUpload();
                    break;
                case 'RiskEvaluation':
                    pageContent = currentRiskResult ? renderRiskEvaluation(currentRiskResult) : renderEmptyEvaluation();
                    break;
                case 'Reports':
                    pageContent = renderReports();
                    break;
                case 'Settings':
                    pageContent = '<div class="bg-white p-16 rounded-2xl shadow-xl text-center"><h2 class="text-2xl font-bold text-gray-800 mb-4">' + pageName + ' Page</h2><p class="text-gray-600">Content for the ' + pageName + ' section will be implemented here.</p></div>';
                    break;
                case 'Login':
                    pageContent = renderLogin();
                    break;
                case 'Register':
                    pageContent = renderRegister();
                    break;
            }
            contentDiv.innerHTML = pageContent;
            window.scrollTo(0, 0);
            
            // Re-attach listeners after rendering dynamic content
            setupDynamicListeners(pageName);
        }

        async function handleFormSubmission(event) {
            if (!userState.isLoggedIn) {
                showTemporaryMessage('Please log in to submit applications.', 'red');
                renderPage('Login');
                return;
            }
            event.preventDefault();
            const form = event.target;
            const formData = {};

            // Collect data from number inputs
            document.querySelectorAll('#risk-evaluation-form input[type="number"]').forEach(input => {
                formData[input.id] = parseFloat(input.value);
            });

            const submitButton = form.querySelector('button[type="submit"]');
            submitButton.innerHTML = '<svg class="animate-spin w-5 h-5 mr-2 text-white" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round" stroke-miterlimit="10" stroke-dasharray="80" stroke-dashoffset="60" style="stroke-opacity: 0.25;"></circle><path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Analyzing...';
            submitButton.disabled = true;

            try {
                // Call the simulated ML model API
                const result = await sendRequestToMLModel(formData);
                currentRiskResult = result;
                
                // Determine final status
                const status = result.final_evaluation === 'Red' ? 'Rejected' : 
                               result.final_evaluation === 'Amber' ? 'Under Review' : 'Accepted';
                
                // Save result to history
                applicationHistory.push({
                    id: result.applicant_id,
                    date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
                    risk: result.final_evaluation,
                    score: result.approval_prediction_pct,
                    status: status,
                    color: result.final_evaluation === 'Low' ? 'green' : result.final_evaluation === 'Amber' ? 'yellow' : 'red'
                });

                showTemporaryMessage('ML Analysis Complete! Check the Evaluation page.', 'green');
                renderPage('RiskEvaluation');
            } catch (error) {
                console.error('Evaluation Error:', error);
                showTemporaryMessage('Evaluation failed. Check console for details.', 'red');
            } finally {
                submitButton.innerHTML = '<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> Run Risk Evaluation';
                submitButton.disabled = false;
            }
        }

        function showTemporaryMessage(message, type) {
            const color = type === 'green' ? 'bg-green-500 text-white' : (type === 'blue' ? 'bg-indigo-500 text-white' : 'bg-red-500 text-white');

            const messageHtml = '' +
                '<div id="temp-message" class="fixed top-20 right-10 z-50 p-4 rounded-lg shadow-xl ' + color + ' transition-opacity duration-300 transform translate-x-0" role="alert">' +
                    '<p class="font-medium">' + message + '</p>' +
                '</div>';
            document.body.insertAdjacentHTML('afterbegin', messageHtml);
            
            setTimeout(() => {
                const tempMsg = document.getElementById('temp-message');
                if (tempMsg) {
                    tempMsg.style.opacity = '0';
                    setTimeout(() => tempMsg.remove(), 300);
                }
            }, 3000);
        }

        // --- Initialization ---
        document.addEventListener('DOMContentLoaded', () => {
            loadUserState(); // Load state from session storage
            
            // Attach click listeners to all menu items using data-page attribute
            document.querySelectorAll('.menu-item').forEach(item => {
                item.addEventListener('click', (e) => {
                    e.preventDefault();
                    const page = item.getAttribute('data-page');
                    if (page) {
                        renderPage(page);
                    }
                });
            });
            
            // Initial render based on auth status
            if (userState.isLoggedIn) {
                renderPage('Dashboard');
            } else {
                renderPage('Login');
            }
        });
    </script>
</body>
</html>
